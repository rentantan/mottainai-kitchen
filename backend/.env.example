# フロントエンドのURL。公開時は実際のURLに変更します。
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file. The default is backend/data/mottainai.db.
# Change this only when you want to store the DB in another persistent folder.
DATABASE_PATH=data/mottainai.db

# Google AI Studioで取得したGemini APIキーを設定します。
# 無料枠を使う場合は課金アカウントをリンクせず、無料枠対象モデルのまま利用してください。
# APIキーは絶対にfrontend/.envへ書かないでください。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45

# 同じ条件のAIレシピはSQLiteに24時間キャッシュ（0にすると実質無効）
RECIPE_CACHE_SECONDS=86400

# 無料枠の使いすぎを防ぐアプリ側の安全上限
GEMINI_MAX_REQUESTS_PER_DAY=8
GEMINI_MAX_REQUESTS_PER_HOUR_PER_IP=5
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=20

